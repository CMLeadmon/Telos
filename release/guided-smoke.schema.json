{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "principal": {
      "pattern": "^[A-Za-z0-9._@+-]{1,128}$",
      "type": "string"
    },
    "safePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._@+=-]+(?:/[A-Za-z0-9._@+=-]+)*$",
      "type": "string"
    },
    "sha256Hex": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicationVersion": {
      "$ref": "#/$defs/name"
    },
    "artifactDigest": {
      "$ref": "#/$defs/digest"
    },
    "assertions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "id": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "notes": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "required": [
          "answer",
          "id",
          "notes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "attachments": {
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "type": "array"
    },
    "candidateLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "deviceModel": {
      "$ref": "#/$defs/name"
    },
    "finishedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "hostId": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^(sha256:[0-9a-f]{64}|[A-Za-z0-9._-]{3,64})$",
      "type": "string"
    },
    "matrix": {
      "enum": [
        "browser",
        "desktop"
      ]
    },
    "os": {
      "$ref": "#/$defs/name"
    },
    "osVersion": {
      "$ref": "#/$defs/name"
    },
    "platform": {
      "$ref": "#/$defs/name"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "startedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "testerPrincipal": {
      "$ref": "#/$defs/principal"
    }
  },
  "required": [
    "applicationVersion",
    "artifactDigest",
    "assertions",
    "attachments",
    "candidateLockDigest",
    "deviceModel",
    "finishedAt",
    "hostId",
    "matrix",
    "os",
    "osVersion",
    "platform",
    "schemaVersion",
    "sourceCommit",
    "startedAt",
    "testerPrincipal"
  ],
  "title": "TelosGuidedSmokeRecord",
  "type": "object"
}
