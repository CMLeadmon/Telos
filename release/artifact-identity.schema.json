{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "natural": {
      "minimum": 0,
      "type": "integer"
    },
    "positive": {
      "minimum": 1,
      "type": "integer"
    },
    "sha256Hex": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[1-9][0-9]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "platform": {
      "const": "linux-x86_64"
    },
    "schemaVersion": {
      "const": 1
    },
    "sha256": {
      "$ref": "#/$defs/sha256Hex"
    },
    "size": {
      "$ref": "#/$defs/natural"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "workflowRunAttempt": {
      "$ref": "#/$defs/positive"
    },
    "workflowRunId": {
      "$ref": "#/$defs/positive"
    }
  },
  "required": [
    "platform",
    "schemaVersion",
    "sha256",
    "size",
    "sourceCommit",
    "version",
    "workflowRunAttempt",
    "workflowRunId"
  ],
  "title": "TelosArtifactIdentity",
  "type": "object"
}
