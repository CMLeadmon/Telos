{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telos backup manifest",
  "description": "Written inside every encrypted backup snapshot. It names what the snapshot contains, which release produced it and the moment all writers were quiescent, so a restore can prove it is applying a complete, matching set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "createdAt", "startedAt", "finishedAt", "consistencyPointAt", "consistencyMethod", "source", "schema", "components", "excluded", "tags"],
  "properties": {
    "formatVersion": {"const": 1},
    "kind": {"const": "telos-backup"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "finishedAt": {"$ref": "#/$defs/timestamp"},
    "consistencyPointAt": {"$ref": "#/$defs/timestamp"},
    "consistencyMethod": {"const": "writers-stopped"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostIdSha256", "sourceCommit", "release", "candidateLockDigest"],
      "properties": {
        "hostIdSha256": {"$ref": "#/$defs/digest"},
        "sourceCommit": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
        "release": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$"},
        "candidateLockDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "migrations"],
      "properties": {
        "current": {"type": "integer", "minimum": 0},
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "name", "checksum"],
            "properties": {
              "version": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1, "maxLength": 200},
              "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "sizeBytes", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 100},
          "kind": {"enum": ["postgres-custom-dump", "mariadb-dump", "node-env", "node-config", "traefik-acme", "jellyfin-config", "grimmory-config", "shared-storage", "release-capsule", "migration-manifest"]},
          "sizeBytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "excluded": {"type": "array", "items": {"enum": ["redis"]}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 140}, "minItems": 1, "uniqueItems": true}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
