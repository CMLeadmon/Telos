{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "gateId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "safePath": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._@+=-]+(?:/[A-Za-z0-9._@+=-]+)*$",
      "type": "string"
    },
    "sha256Hex": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "gates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "envelope": {
            "$ref": "#/$defs/fileRef"
          },
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "$ref": "#/$defs/safePath"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256Hex"
                }
              },
              "required": [
                "kind",
                "path",
                "sha256"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "gateId": {
            "$ref": "#/$defs/gateId"
          },
          "log": {
            "$ref": "#/$defs/fileRef"
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/$defs/fileRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "envelope",
          "files",
          "gateId",
          "log",
          "result"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    }
  },
  "required": [
    "candidateLockDigest",
    "createdAt",
    "gates",
    "schemaVersion",
    "sourceCommit"
  ],
  "title": "TelosEvidenceIndex",
  "type": "object"
}
