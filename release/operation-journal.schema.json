{
  "$defs": {
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "generationId": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "natural": {"minimum": 0, "type": "integer"},
    "timestamp": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fromGeneration": {"oneOf": [{"$ref": "#/$defs/generationId"}, {"type": "null"}]},
    "hostIdSha256": {"$ref": "#/$defs/digest"},
    "kind": {"enum": ["upgrade", "rollback"]},
    "lastError": {"oneOf": [{"maxLength": 300, "type": "string"}, {"type": "null"}]},
    "operationId": {"pattern": "^[0-9a-f]{32}$", "type": "string"},
    "postSchema": {"oneOf": [{"$ref": "#/$defs/natural"}, {"type": "null"}]},
    "preSchema": {"$ref": "#/$defs/natural"},
    "schemaVersion": {"const": 1},
    "snapshotId": {"oneOf": [{"pattern": "^[0-9a-f]{8,64}$", "type": "string"}, {"type": "null"}]},
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "state": {"enum": ["started", "snapshot-verified", "maintenance", "migrating", "migrated", "activated", "serving", "complete", "aborted", "rolled-back", "restore-required", "restored", "failed"]},
    "toGeneration": {"$ref": "#/$defs/generationId"},
    "updatedAt": {"$ref": "#/$defs/timestamp"}
  },
  "required": ["fromGeneration", "hostIdSha256", "kind", "lastError", "operationId", "postSchema", "preSchema", "schemaVersion", "snapshotId", "startedAt", "state", "toGeneration", "updatedAt"],
  "title": "TelosOperationJournal",
  "type": "object"
}
