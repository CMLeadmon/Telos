{
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestDigest", "platforms", "registry", "resolvedAt", "source"],
      "properties": {
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux/amd64"],
          "properties": {"linux/amd64": {"$ref": "#/$defs/digest"}}
        },
        "registry": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?$"},
        "resolvedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "source": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+:[A-Za-z0-9][A-Za-z0-9._-]*$"}
      }
    },
    "section": {"type": "object", "additionalProperties": {"$ref": "#/$defs/entry"}}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelosImageLock",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "schemaVersion", "testImages", "toolImages"],
  "properties": {
    "schemaVersion": {"const": 2},
    "images": {"$ref": "#/$defs/section"},
    "toolImages": {"$ref": "#/$defs/section"},
    "testImages": {"$ref": "#/$defs/section"}
  }
}
