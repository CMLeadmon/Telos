{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "principal": {
      "pattern": "^[A-Za-z0-9._@+-]{1,128}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "certificationDigest": {
      "$ref": "#/$defs/digest"
    },
    "decision": {
      "const": "approved"
    },
    "evidenceIndexDigest": {
      "$ref": "#/$defs/digest"
    },
    "reviewedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "reviewerPrincipal": {
      "$ref": "#/$defs/principal"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "candidateLockDigest",
    "certificationDigest",
    "decision",
    "evidenceIndexDigest",
    "reviewedAt",
    "reviewerPrincipal",
    "schemaVersion"
  ],
  "title": "TelosReleaseReview",
  "type": "object"
}
