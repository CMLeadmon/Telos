{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "principal": {
      "pattern": "^[A-Za-z0-9._@+-]{1,128}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "certifiedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "evidenceIndexDigest": {
      "$ref": "#/$defs/digest"
    },
    "requiredGates": {
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      },
      "minProperties": 1,
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "signerFingerprint": {
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "type": "string"
    },
    "signerPrincipal": {
      "$ref": "#/$defs/principal"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "status": {
      "const": "passed"
    }
  },
  "required": [
    "candidateLockDigest",
    "certifiedAt",
    "evidenceIndexDigest",
    "requiredGates",
    "schemaVersion",
    "signerFingerprint",
    "signerPrincipal",
    "sourceCommit",
    "status"
  ],
  "title": "TelosCertification",
  "type": "object"
}
