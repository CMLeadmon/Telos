{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "generationManifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "generationPath": {
      "maxLength": 512,
      "pattern": "^/[A-Za-z0-9._@+=/-]+$",
      "type": "string"
    },
    "installedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "candidateLockDigest",
    "generationManifestDigest",
    "generationPath",
    "installedAt",
    "schemaVersion"
  ],
  "title": "TelosInstalledGeneration",
  "type": "object"
}
