{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "natural": {
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[1-9][0-9]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactIndexDigest": {
      "$ref": "#/$defs/digest"
    },
    "buildInputs": {
      "additionalProperties": false,
      "properties": {
        "cargoLock": {
          "$ref": "#/$defs/digest"
        },
        "goSum": {
          "$ref": "#/$defs/digest"
        },
        "npmLock": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "cargoLock",
        "goSum",
        "npmLock"
      ],
      "type": "object"
    },
    "imagesLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "migrationManifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceDateEpoch": {
      "$ref": "#/$defs/natural"
    },
    "sourceTag": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[1-9][0-9]*$",
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/version"
    }
  },
  "required": [
    "artifactIndexDigest",
    "buildInputs",
    "imagesLockDigest",
    "migrationManifestDigest",
    "schemaVersion",
    "sourceCommit",
    "sourceDateEpoch",
    "sourceTag",
    "version"
  ],
  "title": "TelosReleaseManifest",
  "type": "object"
}
