{
  "name": "telos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node dev-server.mjs",
    "build": "next build",
    "lint": "eslint .",
    "test:unit": "vitest run && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/*.test.mjs",
    "check:a11y-evidence": "node scripts/check-accessibility-evidence.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:browsers": "node scripts/check-installed-browsers.mjs"
  },
  "dependencies": {
    "epubjs": "0.4.2",
    "hls.js": "1.6.16",
    "lucide-react": "0.525.0",
    "next": "16.2.10",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dom-mediacapture-record": "1.0.22",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "http-proxy": "1.18.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10",
    "xmldom": "npm:@xmldom/xmldom@0.9.10"
  }
}
