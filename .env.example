# ---------------------------------------------------------------------------
# Production inputs — replace every "change-me"/example value before starting
# the production stack. All credentials are supplied only through .env
# interpolation; never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------
TELOS_DOMAIN=community.example.com
ACME_EMAIL=admin@community.example.com
APP_UID=1000
APP_GID=1000
TZ=Etc/UTC

# Host path that backs the shared media/books/files volumes.
STORAGE_PATH=/mnt/storage/shared

POSTGRES_USER=telos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=telos

REDIS_PASSWORD=change-me

LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

JELLYFIN_ADMIN_TOKEN=change-me
# Jellyfin account whose libraries the gateway browses (falls back to the first user)
JELLYFIN_USER_NAME=
# Grimmory admin account the gateway logs in with (created via Grimmory first-run setup)
GRIMMORY_ADMIN_USER=telos-gateway
GRIMMORY_ADMIN_PASSWORD=change-me

GRIMMORY_DB_NAME=grimmory
GRIMMORY_DB_USER=grimmory
GRIMMORY_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Development inputs — only relevant with the loopback-only
# docker-compose.dev.yml overlay; never deploy that overlay to production.
# ---------------------------------------------------------------------------
# Production is the safe default. Use "development" only for loopback-only local work.
TELOS_ENV=production
# One-time token required to create the first (Owner) account via /api/v1/auth/bootstrap
TELOS_BOOTSTRAP_TOKEN=generate-me-with-openssl-rand-hex-24
