# ---------------------------------------------------------------------------
# Production inputs — replace every "change-me"/example value before starting
# the production stack. All credentials are supplied only through .env
# interpolation; never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------
TELOS_DOMAIN=community.example.com
ACME_EMAIL=admin@community.example.com
# Host ports Traefik binds. Leave at 80/443 in production — Let's Encrypt's
# HTTP-01 challenge must reach the public :80. Under a rootless runtime
# (rootless Podman/Docker) privileged ports are unbindable; set these to
# something >=1024, e.g. TRAEFIK_HTTP_PORT=8081 and TRAEFIK_HTTPS_PORT=8443.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
APP_UID=1000
APP_GID=1000
TZ=Etc/UTC

# The single canonical public origin (scheme://host[:port], https in
# production). The exact-origin CSRF/CORS/CSP policy and the CSP wss endpoint
# are derived from this. Defaults to https://${TELOS_DOMAIN} if unset.
TELOS_PUBLIC_ORIGIN=https://community.example.com
# Path to a mode-0600 JSON keyring for signing pagination cursors:
# {"active":"k1","keys":{"k1":"<base64 of >=32 random bytes>"}}. Required in
# production; a development keyring is synthesized when unset.
TELOS_CURSOR_KEYS_FILE=/run/telos/cursor-keys.json
# Path to a mode-0600 file holding the base64 of >=32 random bytes, used only to
# sign opaque HLS resource locators. It MUST be a dedicated secret, never shared
# with the session or cursor keys. Required in production; a distinct
# development key is synthesized when unset.
TELOS_HLS_SIGNING_KEY_FILE=/run/telos/hls-key
# Long-stream admission bounds: max concurrent binary streams node-wide and per
# user. Requests beyond the bound get 503 before any upstream work opens.
TELOS_STREAM_MAX_CONCURRENT=100
TELOS_STREAM_MAX_PER_USER=6
# CIDR(s) of the Traefik ingress network; forwarding headers (X-Forwarded-For)
# are trusted only from these ranges. Matches the telos-ingress subnet.
TELOS_TRUSTED_PROXY_CIDRS=10.201.0.0/24

# Controlled egress: ClamAV/Jellyfin/Grimmory reach the Internet only through
# the deny-by-default telos-egress-proxy (Squid). The reviewed destination
# allowlist lives in config/egress/allowed-domains.txt — adding a host is an
# operator change (see documentation/operations/controlled-egress.md), not an
# .env value. No secret is involved.

# Host path that backs the shared media/books/files volumes.
STORAGE_PATH=/mnt/storage/shared
# Storage quotas (bytes). Defaults: 1 GiB per user, 5 GiB node free-space
# reserve. A zero or unparseable production value is invalid.
TELOS_USER_QUOTA_BYTES=1073741824
TELOS_NODE_RESERVE_BYTES=5368709120

POSTGRES_USER=telos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=telos
# Owner/runtime role split. telos_owner (used only by the one-shot
# telos-migrate service) owns schema objects; telos_runtime is the gateway's
# least-privilege login. On a pre-split existing volume, run
# scripts/provision-db-roles.sh once.
TELOS_OWNER_PASSWORD=change-me
TELOS_RUNTIME_PASSWORD=change-me
# Optional pool tuning (milliseconds). Defaults: statement 5000, lock 2000.
# TELOS_DB_STATEMENT_TIMEOUT_MS=5000
# TELOS_DB_LOCK_TIMEOUT_MS=2000

REDIS_PASSWORD=change-me

JELLYFIN_ADMIN_TOKEN=change-me
# Jellyfin account whose libraries the gateway browses (falls back to the first user)
JELLYFIN_USER_NAME=
# Comma-separated STABLE Jellyfin/Grimmory library IDs the gateway authorizes
# against (upstream IDs, not display names). Required in production; every media
# item and book must belong to one of these.
JELLYFIN_LIBRARY_IDS=
GRIMMORY_LIBRARY_IDS=
# Grimmory admin account the gateway logs in with (created via Grimmory first-run setup)
GRIMMORY_ADMIN_USER=telos-gateway
GRIMMORY_ADMIN_PASSWORD=change-me

GRIMMORY_DB_NAME=grimmory
GRIMMORY_DB_USER=grimmory
GRIMMORY_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Development inputs — only relevant with the loopback-only
# docker-compose.dev.yml overlay; never deploy that overlay to production.
# ---------------------------------------------------------------------------
# Production is the safe default. Use "development" only for loopback-only local work.
TELOS_ENV=production
# Comma-separated finite dev-origin allowlist (only honored when
# TELOS_ENV=development), covering the :3000 frontend → :8080 gateway split.
# TELOS_DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# One-time token required to create the first (Owner) account via /api/v1/auth/bootstrap
TELOS_BOOTSTRAP_TOKEN=generate-me-with-openssl-rand-hex-24
