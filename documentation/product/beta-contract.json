{
  "schemaVersion": 1,
  "architecture": "standalone-client-server",
  "modules": ["chat", "stream", "library", "files"],
  "settingsSurface": "settings",
  "server": {
    "os": "ubuntu-24.04",
    "arch": "x86_64",
    "podmanMinimum": "5.0.0"
  },
  "desktop": ["linux-x86_64", "windows-x86_64", "macos-universal"],
  "browserService": "telos-client",
  "apiService": "telos-core",
  "removedFeatures": [
    "livekit",
    "voice-rooms",
    "watch-parties",
    "notification-inbox",
    "my-list"
  ],
  "backupStatus": "blocked-until-operational-safety",
  "requiredExternalGates": [
    "clean-install",
    "browser-matrix",
    "desktop-linux",
    "desktop-windows",
    "desktop-macos",
    "separate-host-restore",
    "upgrade-rollback",
    "capacity",
    "host-exposure",
    "controlled-egress"
  ]
}
