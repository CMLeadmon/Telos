{
  "schemaVersion": 1,
  "architecture": "standalone-client-server",
  "modules": [
    "chat",
    "stream",
    "library",
    "files"
  ],
  "settingsSurface": "settings",
  "server": {
    "os": "ubuntu-24.04",
    "arch": "x86_64",
    "podmanMinimum": "5.0.0",
