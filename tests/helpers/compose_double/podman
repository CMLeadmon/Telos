#!/usr/bin/env bash
# Test double: answers only `podman compose version` and `podman compose ... config`.
# Everything else fails like an absent runtime would. See render_compose.py.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${1:-}" == "compose" ]]; then
  shift
  if [[ "${1:-}" == "version" ]]; then
    echo "podman-compose test double"
    exit 0
  fi
  if [[ "${*: -1}" == "config" ]]; then
    exec python3 "$here/render_compose.py" "$@"
  fi
fi
echo "podman test double: unsupported invocation: $*" >&2
exit 127
