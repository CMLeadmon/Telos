{
  "schemaVersion": 1,
  "logBounds": {
    "driver": "k8s-file",
    "maxSizeMiB": 10
  },
  "services": {
    "traefik": {
      "container": "telos-traefik",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "traefik"
      },
      "uid": 65532,
      "user": "65532:65532",
      "networks": [
        "telos-ingress"
      ],
      "publishedPorts": [
        {
          "published": "80",
          "target": "8080"
        },
        {
          "published": "443",
          "target": "8443"
        }
      ],
      "listeners": [
        8080,
        8082,
        8443
      ],
      "writable": {
        "volumes": [
          "/letsencrypt"
        ],
        "tmpfs": {}
      },
      "limits": {
        "cpus": 0.5,
        "memoryMiB": 256,
        "pids": 128,
        "nofile": 8192
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "telos-migrate": {
      "container": "telos-migrate",
      "oneShot": true,
      "image": {
        "kind": "built",
        "artifact": "images/gateway"
      },
      "uid": 10001,
      "user": "10001:10001",
      "networks": [
        "telos-db"
      ],
      "publishedPorts": [],
      "listeners": [],
      "writable": {
        "volumes": [],
        "tmpfs": {
          "/tmp": 16
        }
      },
      "limits": {
        "cpus": 1,
        "memoryMiB": 256,
        "pids": 128,
        "nofile": 4096
      },
      "restart": "no",
      "stopGraceSeconds": 0,
      "health": false,
      "capAdd": [],
      "exceptions": []
    },
    "telos-audiobook-migrate": {
      "container": "telos-audiobook-migrate",
      "oneShot": true,
      "image": {
        "kind": "built",
        "artifact": "images/gateway"
      },
      "uid": 10001,
      "user": "10001:10001",
      "networks": [
        "telos-backend",
        "telos-db"
      ],
      "publishedPorts": [],
      "listeners": [],
      "writable": {
        "volumes": [
          "/data/shared"
        ],
        "tmpfs": {
          "/tmp": 16
        }
      },
      "limits": {
        "cpus": 1,
        "memoryMiB": 512,
        "pids": 128,
        "nofile": 4096
      },
      "restart": "no",
      "stopGraceSeconds": 0,
      "health": false,
      "capAdd": [],
      "exceptions": [],
      "profile": "migration"
    },
    "telos-core": {
      "container": "telos-core",
      "oneShot": false,
      "image": {
        "kind": "built",
        "artifact": "images/gateway"
      },
      "uid": 10001,
      "user": "10001:10001",
      "networks": [
        "telos-backend",
        "telos-db",
        "telos-ingress",
        "telos-observability"
      ],
      "publishedPorts": [],
      "listeners": [
        8080,
        9090
      ],
      "writable": {
        "volumes": [
          "/data/shared"
        ],
        "tmpfs": {
          "/tmp": 64
        }
      },
      "limits": {
        "cpus": 2,
        "memoryMiB": 1024,
        "pids": 256,
        "nofile": 16384
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 75,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "telos-client": {
      "container": "telos-client",
      "oneShot": false,
      "image": {
        "kind": "built",
        "artifact": "images/client"
      },
      "uid": 101,
      "user": "101:101",
      "networks": [
        "telos-ingress"
      ],
      "publishedPorts": [],
      "listeners": [
        8080
      ],
      "writable": {
        "volumes": [],
        "tmpfs": {
          "/var/cache/nginx": 16,
          "/var/run": 1
        }
      },
      "limits": {
        "cpus": 0.25,
        "memoryMiB": 128,
        "pids": 64,
        "nofile": 4096
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 15,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "postgres": {
      "container": "telos-postgres",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "postgres"
      },
      "uid": 70,
      "user": "postgres",
      "networks": [
        "telos-db"
      ],
      "publishedPorts": [],
      "listeners": [
        5432
      ],
      "writable": {
        "volumes": [
          "/var/lib/postgresql/data"
        ],
        "tmpfs": {
          "/tmp": 64,
          "/var/run/postgresql": 1
        }
      },
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "pids": 256,
        "nofile": 16384
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": [
        {
          "control": "noNewPrivileges",
          "reason": "On Ubuntu 26.04 no-new-privileges leaves a container's processes under different AppArmor labels (crun's name-only profile stacked under containers-default) and AppArmor denies the signals this image's entrypoint and server depend on, so it never finishes starting. docs/implementation/design-alterations.md A16.",
          "compensating": [
            "non-root user",
            "all capabilities dropped",
            "read-only root filesystem",
            "internal-only network",
            "default AppArmor profile enforced"
          ],
          "expires": "2027-04-30"
        }
      ]
    },
    "redis": {
      "container": "telos-redis",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "redis"
      },
      "uid": 999,
      "user": "redis",
      "networks": [
        "telos-backend"
      ],
      "publishedPorts": [],
      "listeners": [
        6379
      ],
      "writable": {
        "volumes": [
          "/data"
        ],
        "tmpfs": {}
      },
      "limits": {
        "cpus": 0.5,
        "memoryMiB": 512,
        "pids": 128,
        "nofile": 8192
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 20,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "telos-egress-proxy": {
      "container": "telos-egress-proxy",
      "oneShot": false,
      "image": {
        "kind": "built",
        "artifact": "images/egress-proxy"
      },
      "uid": 13,
      "user": "proxy",
      "networks": [
        "telos-backend",
        "telos-egress"
      ],
      "publishedPorts": [],
      "listeners": [
        3128
      ],
      "writable": {
        "volumes": [],
        "tmpfs": {
          "/var/spool/squid": 128,
          "/var/log/squid": 64,
          "/run": 1,
          "/tmp": 16
        }
      },
      "limits": {
        "cpus": 0.5,
        "memoryMiB": 512,
        "pids": 128,
        "nofile": 8192
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 15,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "clamav": {
      "container": "telos-clamav",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "clamav"
      },
      "uid": 100,
      "user": "clamav",
      "networks": [
        "telos-backend"
      ],
      "publishedPorts": [],
      "listeners": [
        3310
      ],
      "writable": {
        "volumes": [
          "/var/lib/clamav"
        ],
        "tmpfs": {
          "/tmp": 64,
          "/run": 4,
          "/var/log/clamav": 16
        }
      },
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "pids": 256,
        "nofile": 8192
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "jellyfin": {
      "container": "telos-jellyfin",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "jellyfin"
      },
      "uid": "app",
      "networks": [
        "telos-backend"
      ],
      "publishedPorts": [],
      "listeners": [
        8096
      ],
      "writable": {
        "volumes": [
          "/config",
          "/cache"
        ],
        "tmpfs": {
          "/tmp": 256
        }
      },
      "limits": {
        "cpus": 4,
        "memoryMiB": 4096,
        "pids": 512,
        "nofile": 32768
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "grimmory-db": {
      "container": "telos-grimmory-db",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "mariadb"
      },
      "uid": 999,
      "user": "mysql",
      "networks": [
        "telos-db"
      ],
      "publishedPorts": [],
      "listeners": [
        3306
      ],
      "writable": {
        "volumes": [
          "/var/lib/mysql"
        ],
        "tmpfs": {
          "/tmp": 64,
          "/run/mysqld": 1
        }
      },
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "pids": 256,
        "nofile": 16384
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": [
        {
          "control": "noNewPrivileges",
          "reason": "On Ubuntu 26.04 no-new-privileges leaves a container's processes under different AppArmor labels (crun's name-only profile stacked under containers-default) and AppArmor denies the signals its entrypoint depends on to stop the temporary initialisation server, so it never finishes starting. docs/implementation/design-alterations.md A16.",
          "compensating": [
            "non-root user",
            "all capabilities dropped",
            "read-only root filesystem",
            "internal-only network",
            "default AppArmor profile enforced"
          ],
          "expires": "2027-04-30"
        }
      ]
    },
    "grimmory": {
      "container": "telos-grimmory",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "grimmory"
      },
      "uid": "app",
      "networks": [
        "telos-backend",
        "telos-db"
      ],
      "publishedPorts": [],
      "listeners": [
        6060
      ],
      "writable": {
        "volumes": [
          "/app/data",
          "/books",
          "/bookdrop"
        ],
        "tmpfs": {
          "/tmp": 256
        }
      },
      "limits": {
        "cpus": 2,
        "memoryMiB": 2048,
        "pids": 512,
        "nofile": 16384
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": []
    },
    "prometheus": {
      "container": "telos-prometheus",
      "oneShot": false,
      "image": {
        "kind": "locked",
        "key": "prometheus"
      },
      "uid": 65534,
      "user": "65534:65534",
      "networks": [
        "telos-observability"
      ],
      "publishedPorts": [],
      "listeners": [
        9090
      ],
      "writable": {
        "volumes": [
          "/prometheus"
        ],
        "tmpfs": {
          "/tmp": 16
        }
      },
      "limits": {
        "cpus": 1,
        "memoryMiB": 1024,
        "pids": 128,
        "nofile": 8192
      },
      "restart": "unless-stopped",
      "stopGraceSeconds": 30,
      "health": true,
      "capAdd": [],
      "exceptions": []
    }
  }
}
