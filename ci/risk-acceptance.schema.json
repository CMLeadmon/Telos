{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelosRiskAcceptances",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptances"],
  "properties": {
    "schemaVersion": {"const": 1},
    "acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "package", "version", "artifactSha256", "owner", "rationale", "issueUrl", "createdAt", "expiresAt"],
        "properties": {
          "id": {"type": "string", "description": "one exact advisory id (CVE-…, GHSA-…, GO-…), never a pattern"},
          "package": {"type": "string", "description": "the exact package name; no wildcards"},
          "version": {"type": "string", "description": "the exact installed version"},
          "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "the one artifact the acceptance covers"},
          "owner": {"type": "string"},
          "rationale": {"type": "string", "minLength": 30},
          "issueUrl": {"type": "string", "pattern": "^https://"},
          "createdAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "expiresAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "at most 30 days after createdAt, and not yet passed"}
        }
      }
    }
  }
}
