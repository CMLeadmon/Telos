# Local environment files (only .env.example is tracked)
.env
.env.*
!.env.example

# Dev-only Compose override (publishes the gateway to localhost for `npm run dev`)
docker-compose.override.yml

# Editor state
.idea/
.vscode/
*.local

# Dependency and build output
node_modules/
.next/
out/
dist/
bin/

# Compiled binaries. The operator CLI cross-compiles for Windows, so the .exe
# variants land here during a GOOS=windows build and must never be committed.
backend/telos-core
backend/telos
backend/telos.exe
backend/telos-core.exe

# Local certificates and secret files
config/certs/
*.pem
*.key

# Backup output and restore staging
backups/
restore-staging/

# Temporary upload staging
uploads-tmp/

# Test reports
test-results/
playwright-report/
coverage/

# Agent worktrees and local release-operator bootstrap material
.worktrees/
.telos-operator/
